*.ipynb filter=nbstripout
*.zpln filter=nbstripout
*.ipynb diff=ipynb

# Bundled n2n model checkpoint (~190 MB) tracked via git-lfs. Single file
# over GitHub's 100 MB hard cap; LFS handles it transparently — cloners get
# the bytes via the standard `git lfs install` + `git clone` path.
src-tauri/python/n2n/weights.pt filter=lfs diff=lfs merge=lfs -text
# Golden test fixtures: captured per-frame engine output (~108k lines of JSON)
# used by `run_goldens` as the regression oracle. Versioned on purpose (the
# capture tool depends on the now-deleted legacy engine, so they can't be
# regenerated), but marked generated so GitHub collapses them in PR diffs.
src-tauri/tests/golden/** linguist-generated=true
src-tauri/tests/golden/** filter=lfs diff=lfs merge=lfs -text
