{
  "normalize": {
    "name": "Normalize",
    "inputs": {
      "value": {"name":"Signal","description":"Value to transform using its range over this clip","value_type":{"signal":{}},"rate":"frame"},
      "samples": {"name":"Samples","description":"Resolution of the prepared clip range","value_type":{"signal":{"unit":"number","channels":"value"}},"rate":"fixed","default":{"type":"number","value":1024.0}}
    },
    "outputs": {"value":{"value_type":{"signal":{"unit":"proportion"}},"rate":"frame"}},
    "body": {"kind":"graph","body":{
      "nodes": {
        "range": {"definition":"clip_range","inputs":{"value":{"source":"input","input":"value"},"samples":{"source":"input","input":"samples"}}},
        "width": {"definition":"core/subtract","inputs":{"a":{"source":"connection","node":"range","output":"maximum"},"b":{"source":"connection","node":"range","output":"minimum"}}},
        "offset": {"definition":"core/subtract","inputs":{"a":{"source":"input","input":"value"},"b":{"source":"connection","node":"range","output":"minimum"}}},
        "scale": {"definition":"core/divide","inputs":{"a":{"source":"connection","node":"offset","output":"value"},"b":{"source":"connection","node":"width","output":"value"}}},
        "limit": {"definition":"core/clamp_coverage","inputs":{"value":{"source":"connection","node":"scale","output":"value"}}}
      },
      "outputs": {"value":{"source":"connection","node":"limit","output":"mask"}}
    }}
  },
  "uniform_mask": {
    "name": "Uniform mask",
    "inputs": {
      "coverage": {"name":"Coverage","description":"Value","value_type":{"signal":{"unit":"proportion","channels":"value"}},"rate":"frame","default":{"type":"proportion","value":1.0}}
    },
    "outputs": {"mask":{"value_type":{"signal":{"unit":"proportion","channels":"value"}},"rate":"frame"}},
    "body": {"kind":"graph","body":{
      "nodes": {
        "mask": {"definition":"core/clamp_coverage","inputs":{"value":{"source":"input","input":"coverage"}}}
      },
      "outputs": {"mask":{"source":"connection","node":"mask","output":"mask"}}
    }}
  },
  "mapped_position": {
    "name": "Mapped position",
    "inputs": {
      "mapping": {"name":"Mapping","description":"Coordinate source, grouping, and orientation","value_type":"mapping","rate":"fixed","default":{"type":"mapping","value":{"source":{"kind":"z"},"per_group":false,"reverse":false}}}
    },
    "outputs": {"value":{"value_type":{"signal":{"unit":"number","channels":"value"}},"rate":"frame"}},
    "body": {"kind":"graph","body":{
      "nodes": {
        "mapping": {"definition":"resolve_mapping","inputs":{"mapping":{"source":"input","input":"mapping"}}},
        "position": {"definition":"coordinate_offset","inputs":{"boundary":{"source":"value","value":{"type":"boundary","value":"clip"}},"mapping":{"source":"connection","node":"mapping","output":"coordinates"},"position":{"source":"value","value":{"type":"position","value":0.0}}}}
      },
      "outputs": {"value":{"source":"connection","node":"position","output":"value"}}
    }}
  },
  "write_strobe": {
    "name": "Strobe output",
    "inputs": {
      "value": {"name":"Coverage","description":"Value","value_type":{"signal":{"unit":"proportion","channels":"value"}},"rate":"frame","default":{"type":"proportion","value":1.0}}
    },
    "outputs": {"strobe":{"value_type":{"signal":{"unit":"proportion","channels":"value"}},"rate":"frame"}},
    "body": {"kind":"graph","body":{
      "nodes": {
        "mask": {"definition":"uniform_mask","inputs":{"coverage":{"source":"input","input":"value"}}},
        "output": {"definition":"core/maximum","inputs":{"a":{"source":"connection","node":"mask","output":"mask"},"b":{"source":"value","value":{"type":"number","value":0.0}}}},
        "output/2": {"definition":"core/minimum","inputs":{"a":{"source":"connection","node":"output","output":"value"},"b":{"source":"value","value":{"type":"number","value":1.0}}}}
      },
      "outputs": {"strobe":{"source":"connection","node":"output/2","output":"value"}}
    }}
  }
}
