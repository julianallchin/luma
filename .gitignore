# Logs
logs/
*.log
bun-debug.log*

# Dependencies
node_modules/

# Build outputs
dist/

# Environment files
.env
.env.*
!.env.example

# Editor directories and files
.DS_Store
.idea/
*.swp

# Rust build artifacts, wherever a target directory lands
target/
# Pixel-feature builds get their own tree so feature flips never evict the
# headless one; see gpui/BUILD.md. Unanchored so it also catches a stray tree
# from a relative CARGO_TARGET_DIR, which cargo resolves against the cwd.
target-pixel/

# Bundled Python runtime (downloaded during build)
backend/python-runtime/*
!backend/python-runtime/.gitkeep

# Bundled ffmpeg binary (downloaded during build)
backend/ffmpeg-runtime/*
!backend/ffmpeg-runtime/.gitkeep

# Python cache files
__pycache__/
*.pyc
*.pyo

# Local tool configs
.claude/
.mcp.json

# SQLite databases
*.sqlite
*.db

# Local scratch: experiments, large datasets and binaries
experiments/

# Harness output: saved screenshots
harness/shots/
harness/goldens/scenes-live/

# The PowerSync test stack's run directory
deploy/test-stack/run/
