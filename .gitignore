# Logs
logs/
*.log
bun-debug.log*

# Dependencies
node_modules/

# Build outputs
dist/

# Environment files
.env
.env.*
!.env.example

# Editor directories and files
.DS_Store
.idea/
*.swp

# Rust build artifacts
target/
backend/target/

# Bundled Python runtime (downloaded during build)
backend/python-runtime/*
!backend/python-runtime/.gitkeep

# Bundled ffmpeg binary (downloaded during build)
backend/ffmpeg-runtime/*
!backend/ffmpeg-runtime/.gitkeep

# Python cache files
__pycache__/
*.pyc
*.pyo

# Local tool configs
.claude/
.mcp.json

# Local tooling scripts (vendor large binary frameworks — not tracked in git).
# The headless agent harness driver is source, not vendored bytes — keep it.
scripts/*
!scripts/headless/
!scripts/arena/
!scripts/library/

# Root docs (canonical docs live in www/)
/docs/*
# …except migration specs — the contract ports are verified against
!/docs/specs/
# …and design docs — architecture decisions implementation is steered by
!/docs/design/
# …and the agent friction log
!/docs/AGENT_FRICTION.md

# SQLite databases
*.sqlite
*.db

# Experiments directory (large datasets/binaries — not tracked in git)
experiments/*
!experiments/powersync/

# Component screenshot harness output + gpui workspace build artifacts
harness/shots/
# `live-goldens` writes fresh captures here for eyeballing; they are not goldens
harness/goldens/scenes-live/
gpui/target/
# Pixel-feature builds get their own tree so feature flips never evict the
# headless one — see gpui/BUILD.md. Unanchored so it also catches a stray tree
# from a *relative* CARGO_TARGET_DIR, which cargo resolves against the cwd:
# running the pixel command from a subdirectory once left 6.8 GB at
# crates/agent/tests/target-pixel/.
target-pixel/

# Perf campaign captures — thousands of retina PNG frames per run, plus the
# library backup and binaries each run folder keeps. The notes and runner
# scripts beside them are tracked; the frames are re-shot by re-running the
# capture.
harness/perf/**/run-*/
harness/perf/**/*.png
experiments/powersync/run/
__pycache__/
