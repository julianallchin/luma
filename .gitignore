# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
bun-debug.log*

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
.vite/

# Environment files
.env
.env.*
!.env.example

# Editor directories and files
.DS_Store
.idea/
*.swp

# Rust / Tauri artifacts
target/
src-tauri/target/
src-tauri/.cargo/
src-tauri/.tauri-build/
src-tauri/gen/

# Bundled Python runtime (downloaded during build)
src-tauri/python-runtime/*
!src-tauri/python-runtime/.gitkeep

# Bundled ffmpeg binary (downloaded during build)
src-tauri/ffmpeg-runtime/*
!src-tauri/ffmpeg-runtime/.gitkeep

# Python cache files
__pycache__/
*.pyc
*.pyo

# this is generated by ts-rs
src/bindings/*.ts

# Local tool configs
.claude/
.mcp.json

# Local tooling scripts (vendor large binary frameworks — not tracked in git).
# The headless agent harness driver is source, not vendored bytes — keep it.
scripts/*
!scripts/headless/
!scripts/arena/

# Root docs (canonical docs live in www/)
/docs/*
# …except migration specs — the contract ports are verified against
!/docs/specs/
# …and design docs — architecture decisions implementation is steered by
!/docs/design/

# SQLite databases
*.sqlite
*.db
SUPABASE_SCHEMA.sql

# Experiments directory (large datasets/binaries — not tracked in git)
experiments/*
!experiments/cs525-data
experiments/cs525-data/*
!experiments/cs525-data/eval
experiments/cs525-data/eval/*
!experiments/cs525-data/eval/drop33_beat_grids.json
!experiments/cs525-data/eval/plots
experiments/cs525-data/eval/plots/*
!experiments/cs525-data/eval/plots/drop33_base.png
!experiments/cs525-data/eval/plots/drop33_tuned.png

# Component screenshot harness output + gpui workspace build artifacts
harness/shots/
gpui/target/
# Pixel-feature builds get their own tree so feature flips never evict the
# headless one — see gpui/BUILD.md. Unanchored so it also catches a stray tree
# from a *relative* CARGO_TARGET_DIR, which cargo resolves against the cwd:
# running the pixel command from a subdirectory once left 6.8 GB at
# crates/agent/tests/target-pixel/.
target-pixel/
# …and the agent friction log
!/docs/AGENT_FRICTION.md
