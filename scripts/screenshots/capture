#!/bin/sh
# Capture the showcase shots from the real app, then compose the website's
# and README's screenshots from them.
#
#   scripts/screenshots/capture [SHOTS_DIR]
#
# SHOTS_DIR (default: experiments/screenshots) keeps the raw retina captures
# in SHOTS_DIR/showcase/; the composed images go to www/public/screenshots/.
# Builds the pixel test runner if it is stale (see gpui/BUILD.md).
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
shots=${1:-"$root/experiments/screenshots"}
mkdir -p "$shots"
LUMA_SHOTS="$shots" "$root/gpui/test" --pixel -j 1 "$here/showcase.test.js"
python3 "$here/composite.py" "$shots"
