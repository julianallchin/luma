#!/bin/sh
# Capture the app's screenshots, then compose the website's and README's
# images from them. See README.md beside this file.
#
#   scripts/screenshots/capture [--library DIR] [SHOTS_DIR]
#
# Without --library the staged showcase library in harness/showcase/ is used.
# With it, DIR is a COPY of a real library (luma.db and its -wal and -shm);
# only the database is read, into a fixture of its own.
#
# SHOTS_DIR (default: experiments/screenshots) keeps the raw retina captures
# in SHOTS_DIR/showcase/; the composed images go to www/public/screenshots/.
# The backdrop is backdrop.jpg beside this file when it exists, else the stage
# capture. Builds the pixel test runner if it is stale (see gpui/BUILD.md).
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../.." && pwd)
script="$here/showcase.test.js"
if [ "${1:-}" = "--library" ]; then
	LUMA_SHOWCASE_LIBRARY=$(CDPATH= cd -- "$2" && pwd)
	export LUMA_SHOWCASE_LIBRARY
	script="$here/library.test.js"
	shift 2
fi
shots=${1:-"$root/experiments/screenshots"}
mkdir -p "$shots"
LUMA_SHOTS="$shots" "$root/gpui/test" --pixel -j 1 "$script"
if [ -f "$here/backdrop.jpg" ]; then
	python3 "$here/composite.py" "$shots" --backdrop "$here/backdrop.jpg"
else
	python3 "$here/composite.py" "$shots"
fi
